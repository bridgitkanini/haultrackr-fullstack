{
  "version": 2,
  "builds": [
    {
      "src": "apps/frontend/vercel-build.js",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "env": {
    "NODE_VERSION": "20"
  }
}
