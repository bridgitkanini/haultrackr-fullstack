{
  "version": 2,
  "buildCommand": "cd apps/frontend && pnpm install && pnpm build",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "regions": ["iad1"],
  "builds": [
    { "src": "apps/frontend/vite.config.ts", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
